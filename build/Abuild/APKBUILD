# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=tdb
pkgver=1.4.14
pkgrel=0
pkgdesc="The tdb library"
url="https://tdb.samba.org/"
arch="all"
license="LGPL-3.0-or-later"
depends="tdb-libs=$pkgver-r$pkgrel"
depends_dev="python3"
makedepends="$depends_dev libxcrypt-dev python3-dev docbook-xsl qnx-io-sock-dev"
subpackages="$pkgname-dev python3-$pkgname:_py3
    $pkgname-libs $pkgname-doc"
source="https://samba.org/ftp/tdb/tdb-$pkgver.tar.gz"
options="!check" # runs forever

build() {
    CFLAGS="$CFLAGS -DHAVE_C99_VSNPRINTF" \
    CXXFLAGS="$CXXFLAGS -DHAVE_C99_VSNPRINTF" \
    LDFLAGS="$LDFLAGS -lsocket" \
    ./configure \
        -p \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --localstatedir=/var \
        --disable-rpath \
        --bundled-libraries=NONE
    make
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install
}

_py3() {
    pkgdesc="Python 3 binding for the tdb library"
    depends="python3 qnx-io-sock $pkgname-libs=$pkgver-r$pkgrel"

    mkdir -p "$subpkgdir"/usr/lib
    mv "$pkgdir"/usr/lib/python3* "$subpkgdir"/usr/lib/
}

sha512sums="
6bc9fe158ff6229d63338e83a6538b6370d82e68039756a8e43fa1afca76cfbfbf182b7cbbf7a3cfab51226b8de15a9fde94af2bb231ba265a83c27a660032eb  tdb-1.4.14.tar.gz
"
